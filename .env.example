# Copie para .env (que o Git ignora) e preencha. Nunca versione o .env.

# Senha do PostgreSQL do docker compose
DB_PASSWORD=troque-esta-senha

# Segredo dos tokens JWT, no mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Opcional: cria o primeiro administrador na inicialização
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=uma-senha-forte
